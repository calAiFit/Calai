# Database
DATABASE_URL='your_postgresql_connection_string'

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Hugging Face (for Food Image Recognition)
NEXT_PUBLIC_HF_TOKEN=your_huggingface_token
HF_TOKEN=your_huggingface_token

# Nutritionix API (for Nutrition Data)
NUTRITIONIX_APP_ID=your_nutritionix_app_id
NUTRITIONIX_APP_KEY=your_nutritionix_app_key
NEXT_PUBLIC_NUTRITIONIX_APP_ID=your_nutritionix_app_id
NEXT_PUBLIC_NUTRITIONIX_APP_KEY=your_nutritionix_app_key

# Cloudinary (for Image Storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI API (for AI Features - Chatbot, Meal Planning, Workout Recommendations)
OPENAI_API_KEY=your_openai_api_key

# Optional: Spoonacular API (for additional recipe data)
SPOONACULAR_API_KEY=your_spoonacular_api_key
NEXT_PUBLIC_SPOONACULAR_API_KEY=your_spoonacular_api_key
